# ---------------------------------------------------------------
# Copie este arquivo para .env.local e preencha os valores.
# No Vercel, cadastre as mesmas chaves em Settings > Environment Variables.
# ---------------------------------------------------------------

# ===== Google Drive (origem) =====
# ID da pasta do Drive (trecho da URL depois de /folders/).
GOOGLE_DRIVE_FOLDER_ID=

# Conteúdo do JSON da Service Account codificado em Base64.
# Linux/macOS: base64 -w 0 service-account.json
GOOGLE_SERVICE_ACCOUNT_BASE64=

# ===== Azure Blob Storage (destino) =====
# Use a Connection String OU a SAS URL. Se ambas existirem,
# a Connection String tem prioridade.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_SAS_URL=

# Nome do contêiner: apenas letras minúsculas, números e hífens (3 a 63).
AZURE_STORAGE_CONTAINER_NAME=aluno-redlint
